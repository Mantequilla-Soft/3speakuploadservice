# 3Speak Upload Service Environment Configuration

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=8080
NODE_ENV=production

# ============================================
# AUTHENTICATION
# ============================================
UPLOAD_SECRET_TOKEN=your-super-secret-upload-token-here-change-this-in-production

# ============================================
# MONGODB CONFIGURATION  
# ============================================
MONGO_URI=mongodb://username:password@host:port/threespeak
ENCODER_MONGO_URI=mongodb://username:password@host:port/spk-encoder-gateway

# ============================================
# 3SPEAK IPFS SUPERNODE CONFIGURATION (PRIMARY)
# ============================================
IPFS_SUPERNODE_URL=http://65.21.201.94:5002

# ============================================
# FALLBACK IPFS CONFIGURATION (LOCAL NODE)
# ============================================
IPFS_FALLBACK_URL=http://localhost:5001
IPFS_FALLBACK_GATEWAY=https://ipfs.yourdomain.com
IPFS_FALLBACK_PORT=8080

# ============================================
# CLEANUP CONFIGURATION  
# ============================================
# Run cleanup every 6 hours (at :00 minutes)
CLEANUP_SCHEDULE_CRON=0 */6 * * *
# Retention in days (0.25 = 6 hours, 1 = 24 hours)
CLEANUP_RETENTION_DAYS=0.25
UPLOAD_SERVICE_ID=simplified-upload-service

# ============================================
# SCHEDULED VIDEO STATUS HEALER
# ============================================
# Run every hour to correct status for scheduled videos
# (Fixes videos marked "published" when they should be "scheduled")
SCHEDULED_VIDEO_CHECK_CRON=0 * * * *

# ============================================
# TUS CONFIGURATION
# ============================================
TUS_UPLOAD_PATH=/tmp/uploads
TUS_ENDPOINT=http://localhost:1080/files

# ============================================
# DEFAULT THUMBNAIL
# ============================================
# Default thumbnail IPFS CID when no thumbnail is provided
# Can be either just the CID or full ipfs:// URI
DEFAULT_THUMBNAIL=QmdU1V8Eefmv5E77Ct6hNG8A3f9b75dZmVS6ZVvw5ynnrn

# ============================================
# 3SPEAK INFRASTRUCTURE
# ============================================
THREESPEAK_IPFS_GATEWAY=https://ipfs.3speak.tv

# ============================================
# THUMBNAIL UPLOAD SERVICES
# ============================================
# Three-tier fallback strategy: Hive → 3Speak → IPFS
# Each service is optional and will be skipped if not configured

# Hive Image Upload (Primary - images.hive.blog)
# Requires a Hive account and posting key
HIVE_IMAGE_ACCOUNT=your-hive-account
HIVE_IMAGE_POSTING_KEY=5KxxxYourHivePostingKeyHerexxxxx

# 3Speak Image Server (Secondary - images.3speak.tv)
# Requires API key from 3Speak infrastructure team
THREESPEAK_IMAGE_URL=https://images.3speak.tv
THREESPEAK_IMAGE_API_KEY=your-3speak-image-api-key-here

# Optional: Override retry and timeout settings
# HIVE_MAX_RETRIES=2
# THREESPEAK_MAX_RETRIES=2
# HIVE_TEMP_DIR=/tmp
# THREESPEAK_TEMP_DIR=/tmp

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# IPFS STORAGE ADMIN CREDENTIALS
# ============================================
# Credentials for accessing storage.html management dashboard
IPFS_STORAGE_ADMIN_USERNAME=admin
IPFS_STORAGE_ADMIN_PASSWORD=change-this-secure-password-in-production